# ============================================================
# Noah Agent Platform - Environment Configuration
# ============================================================
# Usage:
#   1. Copy this file: cp .env.example .env.dev
#   2. Fill in the REQUIRED values below
#   3. Start the server: npm run dev
# ============================================================

# ======================== 必填 (REQUIRED) ========================

# OpenAI API Key (必须填写，否则无法使用)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ======================== LLM 配置 (Optional) ========================

# 自定义 API 地址（国内代理：SiliconFlow / DeepSeek / OpenRouter 等）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 默认模型
# OPENAI_MODEL=gpt-4o-mini

# 前端可选模型列表（逗号分隔）
# AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1,gpt-3.5-turbo

# ======================== 鉴权 (Optional) ========================

# Bearer Token 鉴权密钥
# 空 = 不鉴权（开发模式，任何人都能访问）
# 设值 = 请求必须带 Authorization: Bearer <此值>
# AUTH_SECRET=

# ======================== 可观测 - Langfuse (Optional) ========================

# 配置后自动追踪所有 LLM 调用 + 工具执行
# 不配置 = 不追踪（不影响功能）
# 注册: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ======================== RAG 知识库 (Optional) ========================

# 是否启用 RAG（检索增强生成）
# 首次启用会下载 ~90MB 的 embedding 模型，建议熟悉项目后再开启
# true = 启用（需要下载模型）, false = 关闭（默认）
# ENABLE_RAG=false

# ======================== Web 配置 (Optional) ========================

# CORS 允许的前端地址（一般不需要改）
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
