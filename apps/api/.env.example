# Application
APP_NAME=Noah Agent Platform
DEBUG=true
# development / production。生产会做启动校验（SECRET_KEY 非默认等），不通过则拒绝启动
ENVIRONMENT=development

# 高危工具（删除/转账）：true=完全放开；false 且 HITL_ENABLED=true 时加载但需人审
ALLOW_DANGEROUS_TOOLS=false

# M14 内容安全：送 LLM/落库前 PII 脱敏 + 敏感词拦截
CONTENT_SAFETY_ENABLED=true
# 额外敏感词（逗号分隔）
SENSITIVE_WORDS=
# M14 HITL 人审闭环：高危工具执行前 interrupt 等人工批准
HITL_ENABLED=true
HITL_APPROVAL_TOOLS=transfer_money,delete_all_data
HITL_APPROVAL_TIMEOUT=300

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./noah_agent.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/noah_agent

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
