{
  "name": "agents-cli-learn",
  "version": "4.0.0",
  "description": "Agent learning project - Web-only (FastAPI + LangGraph + MCP)",
  "private": true,
  "scripts": {
    "start": "cd apps/api && source .venv/bin/activate && uvicorn app.main:app --reload --port 8000",
    "dev": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:web": "cd apps/web && npm run dev",
    "build:web": "cd apps/web && npm install && npm run build",
    "diagrams": "python3 -m http.server 9000",
    "diagrams:open": "open http://localhost:9000/docs/diagrams.html",
    "learn": "open http://localhost:9000/docs/learn-game/index.html"
  },
  "keywords": ["agent", "langgraph", "fastapi", "mcp", "learning"],
  "author": "",
  "license": "ISC"
}
